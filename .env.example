# ---------------------------------------------------------------------------
# ThreadMind AI — environment template. Copy to .env. Never commit .env.
# ---------------------------------------------------------------------------

# Application
APP_ENV=development
LOG_LEVEL=INFO
API_BASE_URL=http://localhost:8000

# Database (relational operational data)
DATABASE_URL=postgresql+psycopg://threadmind:threadmind@localhost:5432/threadmind

# Time-series (TimescaleDB extension on the same instance by default)
TIMESCALE_ENABLED=true

# Cache / short-lived coordination
REDIS_URL=redis://localhost:6379/0

# Object storage — fabric images, reports, model artifacts
S3_ENDPOINT=http://localhost:9000
S3_BUCKET=threadmind-dev
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_REGION=us-east-1

# Vector store — technical document retrieval
QDRANT_URL=http://localhost:6333
QDRANT_API_KEY=

# MQTT ingestion
MQTT_BROKER_URL=mqtt://localhost:1883
MQTT_USERNAME=
MQTT_PASSWORD=
MQTT_TOPIC_PREFIX=threadmind

# Authentication
JWT_SECRET=change-me-in-production
JWT_ALGORITHM=HS256
ACCESS_TOKEN_TTL_MINUTES=60

# AI provider abstraction — one key per provider you enable
LLM_PROVIDER=fastrouter
LLM_BASE_URL=https://api.fastrouter.ai/api/v1
LLM_MODEL=openai/gpt-4o-mini
LLM_API_KEY=

# Agents
AGENT_MAX_STEPS=12
AGENT_MAX_TOKENS_PER_RUN=40000
AGENT_REQUIRE_HUMAN_APPROVAL=true

# Service-to-service
VISION_SERVICE_URL=http://localhost:8100
PREDICTIVE_SERVICE_URL=http://localhost:8101
