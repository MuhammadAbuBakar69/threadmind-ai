# Multi-stage build. The image carries code and dependencies, never model artifacts or secrets:
# artifacts are pulled at runtime by URI so a model can be rolled back without a rebuild.
FROM python:3.11-slim AS builder

WORKDIR /build
ENV PIP_NO_CACHE_DIR=1 PIP_DISABLE_PIP_VERSION_CHECK=1

COPY apps/api/requirements.txt .
RUN pip install --prefix=/install -r requirements.txt

FROM python:3.11-slim

RUN useradd --create-home --uid 10001 threadmind
WORKDIR /app

COPY --from=builder /install /usr/local
COPY apps/api /app
# Shared contracts used by both the API and the telemetry simulator. Copied explicitly rather than
# widened into a catch-all so the image cannot quietly grow to include tests or research data.
COPY industrial /app/industrial
# Migrations ship with the image so a deploy does not need a psql client or a host-specific
# pre-deploy hook. See apps/api/migrate.py.
COPY database /app/database
COPY infrastructure/docker/entrypoint.sh /app/entrypoint.sh

ENV PYTHONUNBUFFERED=1 PYTHONDONTWRITEBYTECODE=1 PYTHONPATH=/app
USER threadmind

EXPOSE 8000
HEALTHCHECK --interval=30s --timeout=5s --start-period=10s --retries=3 \
  CMD python -c "import urllib.request; urllib.request.urlopen('http://127.0.0.1:8000/health')"

# RUN_MIGRATIONS=1 applies the schema and forward migrations once at start; unset it when migrations
# are run deliberately from a release job instead.
CMD ["sh", "/app/entrypoint.sh"]
